{
  "_doc": "Run against Adventure.sol (Hardhat) and demo/src/adventure.ts (Vitest). Actors: a0 (deployer), a1. Choice strings are <= 31 ASCII bytes.",
  "scenarios": [
    { "name": "deploy emits root and opens its pathways",
      "init": { "text": "Bees", "choices": ["Kill", "Run", "Dance"] },
      "steps": [], "expect": { "pathways": 3, "author": { "0": "a0" } } },
    { "name": "deploy needs choices", "init": { "text": "Bees", "choices": [] }, "deployRevert": "choises were empty" },
    { "name": "deploy needs text", "init": { "text": "", "choices": ["x"] }, "deployRevert": "situationText were empty" },
    { "name": "add situation links and counts pathways",
      "init": { "text": "Bees", "choices": ["Kill", "Run", "Dance"] },
      "steps": [ { "as": "a1", "call": "addSituation", "args": [0, 0, "Stung", ["Spoon", "Gun"]] } ],
      "expect": { "pathways": 4, "next": [[0, 0, 1], [0, 1, 0]], "author": { "1": "a1" } } },
    { "name": "game over situation (no choices) closes one pathway",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [ { "as": "a0", "call": "addSituation", "args": [0, 0, "The end", []] } ],
      "expect": { "pathways": 1, "next": [[0, 0, 1]] } },
    { "name": "cannot close the last pathway",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [
        { "as": "a0", "call": "addSituation", "args": [0, 0, "The end", []] },
        { "as": "a0", "call": "addSituation", "args": [0, 1, "Also end", []], "revert": "no open pathway" } ],
      "expect": { "pathways": 1, "next": [[0, 1, 0]] } },
    { "name": "blank situation text rejected",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [ { "as": "a0", "call": "addSituation", "args": [0, 0, "", ["x"]], "revert": "text was blank" } ],
      "expect": { "pathways": 2 } },
    { "name": "unknown choice rejected",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [ { "as": "a0", "call": "addSituation", "args": [0, 7, "Nope", ["x"]], "revert": "options" } ],
      "expect": { "pathways": 2 } },
    { "name": "unknown situation rejected",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [ { "as": "a0", "call": "addSituation", "args": [99, 0, "Nope", ["x"]], "revert": "options" } ],
      "expect": { "pathways": 2 } },
    { "name": "choice cannot be written twice",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [
        { "as": "a0", "call": "addSituation", "args": [0, 0, "One", ["x"]] },
        { "as": "a1", "call": "addSituation", "args": [0, 0, "Two", ["x"]], "revert": "choice" } ],
      "expect": { "pathways": 2, "next": [[0, 0, 1]] } },
    { "name": "empty choice text rejected",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [ { "as": "a0", "call": "addSituation", "args": [0, 0, "One", ["ok", ""]], "revert": "cannot be empty" } ],
      "expect": { "pathways": 2 } },
    { "name": "signatures follow authors",
      "init": { "text": "Bees", "choices": ["Kill", "Run"] },
      "steps": [
        { "as": "a1", "call": "addSignature", "args": ["Rostam"] },
        { "as": "a1", "call": "addSituation", "args": [0, 0, "One", ["x"]] },
        { "as": "a1", "call": "addSignature", "args": [""], "revert": "signature cannot be empty" } ],
      "expect": { "signature": { "0": "", "1": "Rostam" } } }
  ]
}
