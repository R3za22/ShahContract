{
  "name": "shahcontract",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Branching story contract (based on Adventureum) with an in-browser Shahnameh demo",
  "license": "UNLICENSED",
  "scripts": {
    "test:contracts": "node node_modules/hardhat/dist/src/cli.js test",
    "test:demo": "node node_modules/vitest/vitest.mjs run --root demo",
    "test": "npm run test:contracts && npm run test:demo",
    "dev:demo": "node node_modules/vite/bin/vite.js --config demo/vite.config.ts",
    "build:demo": "node node_modules/typescript/bin/tsc -p demo && node node_modules/vite/bin/vite.js build --config demo/vite.config.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test -c demo/playwright.config.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "ethers": "^6.17.0",
    "hardhat": "^3.21.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
